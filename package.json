{
  "name": "echo",
  "productName": "Echo",
  "version": "1.0.2",
  "private": true,
  "description": "Tray-resident meeting recorder that pipes structured Markdown into your Obsidian vault.",
  "license": "MIT",
  "main": "electron/entry.cjs",
  "scripts": {
    "dev": "ELECTRON=1 electron .",
    "build:electron": "node scripts/build-electron.cjs",
    "electron:start": "npm run build:electron && ELECTRON=1 electron .",
    "electron:package": "npm run build:electron && electron-forge package",
    "electron:make": "npm run build:electron && electron-forge make"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.1.1",
    "openai": "^6.25.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "electron": "^41.0.3",
    "typescript": "^5.7.3"
  }
}
